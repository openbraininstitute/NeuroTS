{
    "output": "CHANGELOG.md",
    "template": ".auto-changelog-template.hbs",
    "commitLimit": false,
    "backfillLimit": false,
    "ignoreCommitPattern": "^Release:? [0-9]+\\.[0-9]+\\.[0-9]+( ?\\(#[0-9]+\\))?$|^Update CHANGELOG.*|.*\\[skip-changelog\\].*|^\\[pre-commit.ci\\]|^\\(dependabot\\) .*",
    "commitUrl": "https://github.com/openbraininstitute/NeuroTS/commit/{id}",
    "issueUrl": "https://github.com/openbraininstitute/NeuroTS/issues/{id}",
    "mergeUrl": "https://github.com/openbraininstitute/NeuroTS/pull/{id}",
    "compareUrl": "https://github.com/openbraininstitute/NeuroTS/compare/{from}..{to}",
    "startingVersion": "3.4.2"
}
